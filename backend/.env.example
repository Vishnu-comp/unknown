# Gmail account used as the sender
EMAIL_USERNAME=you@gmail.com
# Google App Password (NOT your normal password)
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

PORT=3000
HOST=0.0.0.0

# Delay between mails in one batch (ms)
SEND_DELAY_MS=15000

# Optional PDF attached to every initial email
# ATTACHMENT_PATH=./assets/resume.pdf

# Where follow-up Message-IDs are persisted
# MESSAGE_STORE_PATH=./messageStore.json
